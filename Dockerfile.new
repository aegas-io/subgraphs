# Project: v3-subgraph
# Description: Multi-stage build for self-hosted Graph Node deployment

######################################################################
# STAGE 1: BUILD
######################################################################
ARG PY_VER=3.11
FROM python:${PY_VER} AS builder

######################################################################
# LABELS
######################################################################
ARG COMMIT_ID
ARG COMMIT_TIMESTAMP
ARG COMMIT_AUTHOR
ARG BUILD_APPLICATION
ARG BUILD_DATE

LABEL org.vcs.CommitId=${COMMIT_ID}
LABEL org.vcs.CommitTimestamp=${COMMIT_TIMESTAMP}
LABEL org.vcs.CommitAuthor=${COMMIT_AUTHOR}
LABEL org.build.Application=${BUILD_APPLICATION}
LABEL org.build.Date=${BUILD_DATE}

######################################################################
# INSTALL DEPENDENCIES
######################################################################
RUN apt-get update && \
    apt-get install --no-install-recommends -y tini jq && \
    curl -fsSL https://deb.nodesource.com/setup_18.x | bash - && \
    apt-get install -y nodejs=18.17.1-1nodesource1 && \
    node -v >> debug.txt && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Install graph-cli
RUN npm install -g @graphprotocol/graph-cli@0.79.2

# Install Python dependencies
RUN pip install --upgrade --no-cache pip && \
    pip install PyYAML --no-cache --default-timeout=60

######################################################################
# BUILD SUBGRAPH
######################################################################
WORKDIR /build

# Copy package files and install Node dependencies
COPY package.json /build/
RUN npm install

# Copy all project files
COPY . /build/

# Run manager.py to generate schema, subgraph.yaml, codegen, and build.
# To graft on this deploy, set GRAFT_BASE + GRAFT_BLOCK below to non-empty
# values (the running prod deployment's IPFS hash and a block ~200 behind
# its head). Leave both empty for a normal (non-grafted) build.
ARG GRAFT_BASE="QmQFesWs3oHrtgN3ocpXk88arbwvFKYz9hAj1BcugRumTH"
ARG GRAFT_BLOCK="7059316"
RUN if [ -n "$GRAFT_BASE" ] && [ -n "$GRAFT_BLOCK" ]; then \
      python3 scripts/manager.py configs/perps/coti.json perps/analytics \
        --graft-base "$GRAFT_BASE" --graft-block "$GRAFT_BLOCK"; \
    else \
      python3 scripts/manager.py configs/perps/coti.json perps/analytics; \
    fi

######################################################################
# STAGE 2: DEPLOYMENT IMAGE
######################################################################
FROM node:18-slim

WORKDIR /app

# Install graph-cli globally for deployment
RUN npm install -g @graphprotocol/graph-cli@0.79.2

# Copy entire built subgraph from builder
# Note: The build happens in the root, not in perps/analytics
# The subgraph.yaml references files like ./perps/analytics/src_*.ts

# Copy package.json and node_modules (required by graph deploy)
COPY --from=builder /build/package.json ./package.json
COPY --from=builder /build/node_modules ./node_modules

# Copy subgraph files
COPY --from=builder /build/subgraph.yaml ./subgraph.yaml
COPY --from=builder /build/schema.graphql ./schema.graphql
COPY --from=builder /build/build ./build
COPY --from=builder /build/generated ./generated
COPY --from=builder /build/abis ./abis
COPY --from=builder /build/perps ./perps

# Copy deployment script
COPY deploy.sh ./
RUN chmod +x ./deploy.sh

# Set the entrypoint to deploy the pre-built subgraph
ENTRYPOINT ["./deploy.sh"]
